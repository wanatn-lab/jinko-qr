@echo off
rem Start the print agent from this script's directory.
chcp 65001 >nul
title ระบบเชื่อมเครื่องพิมพ์ครัว - อย่าปิดหน้าต่างนี้
color 0A
cd /d "%~dp0"

if not exist "node_modules" (
  echo ================================================
  echo   ติดตั้งครั้งแรก กรุณารอสักครู่ (ทำครั้งเดียว)
  echo   ห้ามปิดหน้าต่างนี้จนกว่าจะเสร็จ...
  echo ================================================
  echo.
  call npm install
  if errorlevel 1 (
    echo.
    echo *** ติดตั้งไม่สำเร็จ ***
    echo ตรวจสอบว่าลง Node.js แล้วหรือยัง ดาวน์โหลดได้ที่ nodejs.org
    echo.
    pause
    exit /b 1
  )
  echo.
  echo ติดตั้งเสร็จแล้ว กำลังเริ่มโปรแกรม...
  echo.
)

:run
echo ================================================
echo   ระบบเชื่อมเครื่องพิมพ์ครัวกำลังทำงานอยู่
echo   หน้าต่างนี้ต้องเปิดค้างไว้ตลอดเวลาร้านเปิด
echo   ห้ามปิดหน้าต่างนี้จนกว่าจะปิดร้าน
echo ================================================
echo.
call npm start

echo.
echo *** โปรแกรมหยุดทำงาน (อาจมีปัญหาการเชื่อมต่ออินเทอร์เน็ตหรือเครื่องพิมพ์) ***
echo กำลังลองเริ่มใหม่ให้อัตโนมัติใน 10 วินาที...
echo (ถ้าไม่อยากให้ลองใหม่ ปิดหน้าต่างนี้ได้เลย)
timeout /t 10 /nobreak >nul
goto run
