#!/bin/bash
# Double-click this file (or the copy on your Desktop) to start the kitchen
# print system on this Mac. Keep the window open the whole time the shop
# is open — closing it stops printing.
cd "$(dirname "$0")"

if ! command -v node >/dev/null 2>&1; then
  echo "================================================"
  echo "  ยังไม่ได้ติดตั้ง Node.js บนเครื่องนี้"
  echo "  กรุณาโหลดและติดตั้งจาก https://nodejs.org ก่อน"
  echo "  แล้วเปิดไฟล์นี้ใหม่อีกครั้ง"
  echo "================================================"
  echo ""
  read -p "กด Enter เพื่อปิดหน้าต่างนี้..."
  exit 1
fi

if [ ! -d "node_modules" ]; then
  echo "================================================"
  echo "  ติดตั้งครั้งแรก กรุณารอสักครู่ (ทำครั้งเดียว)"
  echo "  ห้ามปิดหน้าต่างนี้จนกว่าจะเสร็จ..."
  echo "================================================"
  echo ""
  npm install
  if [ $? -ne 0 ]; then
    echo ""
    echo "*** ติดตั้งไม่สำเร็จ ***"
    echo "ลองปิดหน้าต่างนี้แล้วเปิดไฟล์นี้ใหม่อีกครั้ง"
    echo ""
    read -p "กด Enter เพื่อปิดหน้าต่างนี้..."
    exit 1
  fi
  echo ""
  echo "ติดตั้งเสร็จแล้ว กำลังเริ่มโปรแกรม..."
  echo ""
fi

while true; do
  echo "================================================"
  echo "  ระบบเชื่อมเครื่องพิมพ์ครัวกำลังทำงานอยู่"
  echo "  หน้าต่างนี้ต้องเปิดค้างไว้ตลอดเวลาร้านเปิด"
  echo "  ห้ามปิดหน้าต่างนี้จนกว่าจะปิดร้าน"
  echo "================================================"
  echo ""
  npm start

  echo ""
  echo "*** โปรแกรมหยุดทำงาน (อาจมีปัญหาการเชื่อมต่ออินเทอร์เน็ตหรือเครื่องพิมพ์) ***"
  echo "กำลังลองเริ่มใหม่ให้อัตโนมัติใน 10 วินาที..."
  echo "(ถ้าไม่อยากให้ลองใหม่ ปิดหน้าต่าง Terminal นี้ได้เลย)"
  sleep 10
done
